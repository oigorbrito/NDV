{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ndv-luna-decomposition-plan-schema-v1",
  "title": "NDV Luna-only structured decomposition plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "task_id",
    "objective",
    "constraints",
    "steps",
    "final_verification"
  ],
  "properties": {
    "schema_id": {
      "const": "ndv-luna-decomposition-plan-v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "constraints": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "dependencies",
          "expected_artifact",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[1-8]$"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "dependencies": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "type": "string",
              "pattern": "^S[1-8]$"
            }
          },
          "expected_artifact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        }
      }
    },
    "final_verification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    }
  }
}
